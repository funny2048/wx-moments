<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.funny</groupId>
        <artifactId>moments</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>moments-web</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.funny</groupId>
            <artifactId>moments-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.funny</groupId>
            <artifactId>moments-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.funny</groupId>
            <artifactId>funny-springboot-starter-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.funny</groupId>
            <artifactId>funny-springboot-starter-web</artifactId>
        </dependency>
        <!-- 阶段六 dev 集成测试基座（MockMvc/JUnit5/JsonPath/Hamcrest），版本由 funny-springboot-starter-parent 的 spring-boot-dependencies 管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- 项目日志栈为 log4j2（log4j-slf4j2-impl），排除 starter-logging（logback + log4j-to-slf4j），
                 两者共存触发 Log4jLoggerFactory 冲突：log4j-slf4j2-impl cannot be present with log4j-to-slf4j -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
